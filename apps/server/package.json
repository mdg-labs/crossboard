{
  "name": "@crossboard/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
